{
  "name": "rando",
  "author": "brine",
  "description": "A random generator for ttrpg gms",
  "version": "2.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "standard": {
    "env": [
      "browser"
    ]
  },
  "scripts": {
    "test": "node --test --test-reporter spec test/**/*.test.js",
    "chalk": "wrangler secret put CHALK_HIT_SECRET",
    "pretty": "npx standard --fix",
    "deploy": "wrangler deploy",
    "db": "wrangler d1 migrations apply rando --remote",
    "purge": "curl -X POST \"https://api.cloudflare.com/client/v4/zones/$BRINE_TOKEN/purge_cache\" -H \"Authorization: Bearer $BEARER\" -H \"Content-Type: application/json\" --data '{\"purge_everything\":true}'"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
